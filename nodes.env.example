# CKS lab node configuration — copy to nodes.env and fill in your own values.
# nodes.env is gitignored: it holds environment-specific addresses, not secrets
# you want in the repo.
#
#   cp nodes.env.example nodes.env
#   $EDITOR nodes.env
#   . ./nodes.env          # before running lab commands by hand

# Control-plane node (k8s-master)
export MASTER_IP=10.0.0.10

# Worker node (k8s-agent)
export AGENT_IP=10.0.0.11

# Unprivileged SSH user on both nodes (must have passwordless sudo)
export SSH_USER=youruser
